<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The window takes its colours from alphapremiergroup.com: brand gold,
      black panels. None of it touches the printed card, whose colours come
      from the artwork.

      Gold is used for fills and on black. On white it is only 2.1:1 against
      the background, too faint to read, so gold TEXT on a light background
      uses the darker Color.Accent (5.0:1 on white, 4.6:1 on Color.Bg).

      Two tiers. The Palette.* colours are raw values; everything else is
      named for what it is for, and the window only ever uses those.
    -->
    <Color x:Key="Palette.Paper">#F5F5F2</Color>
    <Color x:Key="Palette.White">#FFFFFF</Color>
    <Color x:Key="Palette.Ink">#1D1C1A</Color>
    <Color x:Key="Palette.Grey">#66625A</Color>
    <Color x:Key="Palette.Rule">#E2DFD6</Color>
    <Color x:Key="Palette.RuleStrong">#8C877B</Color>
    <Color x:Key="Palette.Black">#000000</Color>
    <Color x:Key="Palette.Smoke">#E0E0E0</Color>
    <Color x:Key="Palette.Ash">#A8A8A8</Color>
    <Color x:Key="Palette.Charcoal">#1F1F1F</Color>
    <Color x:Key="Palette.Gold">#D4AF37</Color>
    <Color x:Key="Palette.GoldBright">#E3C257</Color>
    <Color x:Key="Palette.GoldDeep">#8A6A14</Color>
    <Color x:Key="Palette.GoldWash">#FBF4DC</Color>
    <Color x:Key="Palette.Blue">#2F6FD6</Color>
    <Color x:Key="Palette.Red">#B3261E</Color>
    <Color x:Key="Palette.RedWash">#FCEEEC</Color>
    <Color x:Key="Palette.Amber">#7A4F00</Color>

    <SolidColorBrush x:Key="Color.Bg" Color="{StaticResource Palette.Paper}" />
    <SolidColorBrush x:Key="Color.Surface" Color="{StaticResource Palette.White}" />
    <SolidColorBrush x:Key="Color.Text" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Color.TextMuted" Color="{StaticResource Palette.Grey}" />
    <SolidColorBrush x:Key="Color.Line" Color="{StaticResource Palette.Rule}" />
    <SolidColorBrush x:Key="Color.ControlBorder" Color="{StaticResource Palette.RuleStrong}" />
    <SolidColorBrush x:Key="Color.Tray" Color="{StaticResource Palette.Black}" />
    <SolidColorBrush x:Key="Color.TrayRaised" Color="{StaticResource Palette.Charcoal}" />
    <SolidColorBrush x:Key="Color.TrayInk" Color="{StaticResource Palette.Smoke}" />
    <SolidColorBrush x:Key="Color.TrayMuted" Color="{StaticResource Palette.Ash}" />
    <SolidColorBrush x:Key="Color.Accent" Color="{StaticResource Palette.GoldDeep}" />
    <SolidColorBrush x:Key="Color.AccentSolid" Color="{StaticResource Palette.Gold}" />
    <SolidColorBrush x:Key="Color.AccentSolidHover" Color="{StaticResource Palette.GoldBright}" />
    <SolidColorBrush x:Key="Color.AccentWash" Color="{StaticResource Palette.GoldWash}" />
    <SolidColorBrush x:Key="Color.OnAccent" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Color.Focus" Color="{StaticResource Palette.Blue}" />
    <SolidColorBrush x:Key="Color.Danger" Color="{StaticResource Palette.Red}" />
    <SolidColorBrush x:Key="Color.DangerWash" Color="{StaticResource Palette.RedWash}" />
    <SolidColorBrush x:Key="Color.Warning" Color="{StaticResource Palette.Amber}" />

    <!-- A focus ring you can see on white and on black: two pixels of blue, set off from the control. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9" StrokeThickness="2" Stroke="{StaticResource Color.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Type: four sizes, and nothing smaller than 13. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}" />
    </Style>
    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Note}">
        <Setter Property="Foreground" Value="{StaticResource Color.Danger}" />
    </Style>
    <Style x:Key="Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource Text.Note}">
        <Setter Property="Foreground" Value="{StaticResource Color.Warning}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
    </Style>

    <!-- Buttons. Every one is at least 40 high, so it can be hit without aiming. -->
    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Color.AccentSolid}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.AccentSolid}" />
        <Setter Property="Foreground" Value="{StaticResource Color.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.AccentSolidHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.ControlBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.AccentWash}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.OnTray" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Color.TrayRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.TrayMuted}" />
        <Setter Property="Foreground" Value="{StaticResource Color.TrayInk}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Color.AccentSolid}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Reads as a link, but is a button: it does something rather than going somewhere. -->
    <Style x:Key="Button.Link" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Color.Accent}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.AccentWash}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One of the four tools in the rail. Checked while its drawer is open. -->
    <Style x:Key="Button.Rail" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Color.AccentWash}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Color.AccentWash}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Color.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice among a few: job titles, card side, print layout. A real radio button underneath, so arrow keys work. -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{StaticResource Color.Surface}" BorderBrush="{StaticResource Color.ControlBorder}"
                            BorderThickness="1" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- the tick says "chosen" without relying on colour -->
                            <Path x:Name="Tick" Data="M1,6 L5,10 L12,2" Stroke="{StaticResource Color.OnAccent}" StrokeThickness="2"
                                  Width="13" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Color.AccentWash}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Color.AccentSolid}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Color.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip.OnTray" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Color.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Color.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <!-- A white panel on the grey page: the drawer and the form. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
</ResourceDictionary>
